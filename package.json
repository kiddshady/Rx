{
  "name": "rx",
  "productName": "Rx",
  "version": "0.1.3",
  "description": "Historia clínica, recetas y órdenes de estudios para consultorio. Datos cifrados en disco, firma manuscrita.",
  "main": "main.cjs",
  "author": "Francisco Pavez",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/tokens.test.mjs && node test/store.test.mjs && node test/format.test.mjs",
    "test:datos": "electron test/datos.test.cjs",
    "rebuild:nativos": "prebuild-install -C node_modules/better-sqlite3-multiple-ciphers --runtime=electron --target=40.10.6 --dist-url=https://electronjs.org/headers",
    "humo": "electron test/humo.test.cjs",
    "icon": "electron build/make-icon.cjs",
    "build": "electron-builder --win --publish never",
    "test:paquete": "electron test/empaquetado.test.cjs"
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.kiddshady.rx",
    "productName": "Rx",
    "copyright": "Copyright © 2026 Francisco Pavez",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!build/make-icon.cjs",
      "!data/**",
      "!test/**",
      "!dist/**"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3-multiple-ciphers/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "kiddshady",
      "repo": "Rx"
    }
  }
}
